# Environment variables example
# Copy this file to .env and fill in your own values

# Sentry Configuration
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys (DSN)
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# Amplitude Analytics Configuration
# Get your API key from https://amplitude.com -> Project Settings -> General -> API Key
AMP=your_amplitude_api_key_here 

# Wallet Connector
WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here

# Mainnet Authentication Configuration
# Set MAINNET_AUTH_ENABLED=true to require password authentication (pre-launch)
# Set MAINNET_AUTH_ENABLED=false to disable authentication (public launch)
MAINNET_AUTH_ENABLED=true
MAINNET_PASSWORD=your_secure_password_here

# Network RPC Configuration
# RPC endpoints for different networks
NUXT_PUBLIC_MAINNET_RPC=https://rpc1.monad.xyz
NUXT_PUBLIC_TESTNET_RPC=https://rpc-testnet.monadinfra.com

# Chain ID Configuration
NUXT_PUBLIC_MAINNET_CHAIN_ID=143
NUXT_PUBLIC_TESTNET_CHAIN_ID=10143